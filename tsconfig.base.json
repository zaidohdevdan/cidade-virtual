{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@cidade-virtual/types": ["packages/types/index.ts"],
      "@cidade-virtual/tools": ["packages/tools/index.ts"],
      "@cidade-virtual/tools/schemas": ["packages/tools/schemas.ts"],
      "@cidade-virtual/tools/*": ["packages/tools/*"],
      "@cidade-virtual/memory": ["packages/memory/index.ts"],
      "@cidade-virtual/memory/*": ["packages/memory/*"],
      "@cidade-virtual/agents": ["packages/agents/index.ts"],
      "@cidade-virtual/agents/*": ["packages/agents/*"],
      "@cidade-virtual/config": ["packages/config/index.ts"],
      "@cidade-virtual/config/*": ["packages/config/*"],
      "@cidade-virtual/api": ["apps/api/src/main.ts"],
      "@cidade-virtual/api/tools": ["apps/api/src/tools/index.ts"],
      "@cidade-virtual/api/services": ["apps/api/src/services/index.ts"],
      "@cidade-virtual/api/*": ["apps/api/src/*"],
      "@cidade-virtual/web-client": ["apps/web-client/src/main.tsx"],
      "@cidade-virtual/admin": ["apps/admin/src/index.ts"],
      "@cidade-virtual/llm-adapters": ["packages/llm-adapters/index.ts"],
      "@cidade-virtual/agent-cognition": ["packages/agent-cognition/index.ts"],
      "@cidade-virtual/world-engine": ["packages/world-engine/index.ts"],
      "@cidade-virtual/observability": ["packages/observability/index.ts"],
      "@cidade-virtual/event-system": ["packages/event-system/index.ts"],
      "@cidade-virtual/event-system/*": ["packages/event-system/*"]
    }
  }
}
