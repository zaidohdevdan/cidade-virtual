{
  "name": "@cidade-virtual/api",
  "version": "1.0.0",
  "main": "./src/main.ts",
  "types": "./src/main.ts",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
